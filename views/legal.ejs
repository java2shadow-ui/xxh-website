<%- include('partials/header-v2', { path: 'legal', langBase: '/' + LG.slug, pageCss: ['/static/css/home-v2.css?v=20261102a', '/static/css/pages-v2.css?v=20261102a'] }) %>
<style>
  .lg-page{background:#fff;padding:56px 0 72px}
  .lg-page .wrap{max-width:820px}
  .lg-page h1{font-size:30px;line-height:1.25;color:#0B2540;margin:0 0 10px;letter-spacing:-.01em}
  .lg-page .up{font-size:12px;color:#7A8CA3;margin:0 0 34px;font-family:var(--mo);letter-spacing:.02em}
  .lg-page section{padding:0 0 22px;margin:0 0 22px;border-bottom:1px solid #EDF1F6}
  .lg-page section:last-child{border-bottom:none;margin-bottom:0}
  .lg-page h2{font-size:15px;font-weight:700;color:#12395C;margin:0 0 9px;letter-spacing:.01em}
  .lg-page p{font-size:14px;line-height:1.85;color:#41566E;margin:0}
  .lg-page .contact-bar{margin-top:34px;padding:18px 20px;background:#F5F8FC;border:1px solid #E3EBF4;border-radius:10px;font-size:13px;color:#41566E;line-height:1.7}
  .lg-page .contact-bar b{color:#0B2540}
  @media(max-width:640px){.lg-page{padding:36px 0 52px}.lg-page h1{font-size:23px}.lg-page p{font-size:13.5px}}
</style>
<main class="lg-page">
  <div class="wrap">
    <h1><%= LG.d.t %></h1>
    <p class="up"><%= LG.d.up %></p>
    <% LG.d.s.forEach(function (sec, i) { %>
    <section>
      <h2><%= (i + 1) + '. ' + sec[0] %></h2>
      <p><%= sec[1] %></p>
    </section>
    <% }); %>
    <div class="contact-bar">
      <b><%= lang === 'zh' ? '宁波纤讯和新材料有限公司' : 'Ningbo Xianxunhe New Materials Co., Ltd.' %></b><br>
      <%= lang === 'zh' ? '浙江省余姚市中国塑料城国际商务中心 1 幢 335 室' : 'Room 335, Building 1, China Plastic City International Business Center, Yuyao, Ningbo, Zhejiang, China' %><br>
      <a href="mailto:<%= settings.email %>"><%= settings.email %></a> · <a href="tel:<%= String(settings.phone||'').replace(/[^0-9+]/g,'') %>"><%= settings.phone %></a>
    </div>
  </div>
</main>
<%- include('partials/footer-v2') %>
