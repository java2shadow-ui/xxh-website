<%- include('partials/header-v2', { path: 'about', langBase: '/about', pageCss: ['/static/css/style.css?v=20261024b','/static/css/pages-v2.css?v=20261102a'] }) %>

<section style="padding:48px 0 64px">
  <div class="wrap">
    <span class="kicker"><%= t.about_t %></span>
    <h1 class="page-h1"><%= t.about_s %></h1>
    <div style="margin-top:26px;max-width:820px">
      <p class="about-p"><%= t.about_p1 %></p>
      <p class="about-p"><%= t.about_p2 %></p>
      <p class="about-p"><%= t.about_p3 %></p>
    </div>
    <div class="about-grid">
      <div class="why"><span class="num">01</span><h3><%= t.about_v1_t %></h3><p><%= t.about_v1_d %></p></div>
      <div class="why"><span class="num">02</span><h3><%= t.about_v2_t %></h3><p><%= t.about_v2_d %></p></div>
      <div class="why"><span class="num">03</span><h3><%= t.about_v3_t %></h3><p><%= t.about_v3_d %></p></div>
      <div class="why"><span class="num">04</span><h3><%= t.about_v4_t %></h3><p><%= t.about_v4_d %></p></div>
    </div>
    <% var AB = {
      en: { t: 'Real operations, not stock photos', wh: 'Warehouse & loading yard, Ningbo', cl: 'Container loading — palletized, stretch-wrapped', of: 'Yuyao office — China Plastic City', lic: 'Business licence', lic_note: 'Registered in Yuyao, Ningbo since 2021 · Import & export licensed · Unified social credit code 91330281MA2J5J8M8B' },
      zh: { t: '真实运营场景，不是图库素材', wh: '宁波仓库与装货场', cl: '集装箱装柜 — 托盘打托、缠膜加固', of: '余姚办公室 — 中国塑料城', lic: '营业执照', lic_note: '2021 年注册于宁波余姚 · 具备货物进出口与进出口代理资质 · 统一社会信用代码 91330281MA2J5J8M8B' },
      ru: { t: 'Реальные операции, а не стоковые фото', wh: 'Склад и погрузочная площадка, Нинбо', cl: 'Загрузка контейнера — на паллетах, в стретч-плёнке', of: 'Офис в Юйяо — China Plastic City', lic: 'Свидетельство о регистрации', lic_note: 'Зарегистрирована в Юйяо (Нинбо) с 2021 г. · Есть право на импорт и экспорт · УНН 91330281MA2J5J8M8B' },
      vi: { t: 'Hình ảnh vận hành thực tế, không phải ảnh stock', wh: 'Kho và bãi xếp hàng, Ninh Ba', cl: 'Đóng container — hàng pallet, quấn màng co', of: 'Văn phòng Dư Diêu — China Plastic City', lic: 'Giấy phép kinh doanh', lic_note: 'Đăng ký tại Dư Diêu, Ninh Ba từ 2021 · Có quyền xuất nhập khẩu · MST 91330281MA2J5J8M8B' },
      th: { t: 'ภาพการดำเนินงานจริง ไม่ใช่ภาพสต็อก', wh: 'คลังสินค้าและลานโหลด หนิงโป', cl: 'การบรรจุตู้คอนเทนเนอร์ — บนพาเลท พันฟิล์ม', of: 'สำนักงานอวี้เหยา — China Plastic City', lic: 'ใบอนุญาตประกอบธุรกิจ', lic_note: 'จดทะเบียนที่อวี้เหยา หนิงโป ตั้งแต่ปี 2021 · มีสิทธิ์นำเข้า-ส่งออก · เลขทะเบียน 91330281MA2J5J8M8B' },
      id: { t: 'Operasi nyata, bukan foto stok', wh: 'Gudang dan area bongkar, Ningbo', cl: 'Muat kontainer — palet, dibungkus stretch film', of: 'Kantor Yuyao — China Plastic City', lic: 'Izin usaha', lic_note: 'Terdaftar di Yuyao, Ningbo sejak 2021 · Memiliki izin ekspor-impor · NIB 91330281MA2J5J8M8B' }
    }[lang] || null; %>
    <% if (AB) { %>
    <div class="ab-photos">
      <h3 class="ab-h"><%= AB.t %></h3>
      <div class="ab-grid">
        <figure>
          <img src="/assets/photos/warehouse-yard.jpg" alt="<%= AB.wh %>" loading="lazy" decoding="async">
          <figcaption><%= AB.wh %></figcaption>
        </figure>
        <figure>
          <img src="/assets/photos/container-loading.jpg" alt="<%= AB.cl %>" loading="lazy" decoding="async">
          <figcaption><%= AB.cl %></figcaption>
        </figure>
        <figure>
          <img src="/assets/photos/office-ningbo.jpg" alt="<%= AB.of %>" loading="lazy" decoding="async">
          <figcaption><%= AB.of %></figcaption>
        </figure>
      </div>
      <div class="ab-lic">
        <img src="/assets/photos/business-license.jpg" alt="<%= AB.lic %>" loading="lazy" decoding="async">
        <div>
          <h4><%= AB.lic %></h4>
          <p><%= AB.lic_note %></p>
        </div>
      </div>
    </div>
    <style>
      .ab-photos{margin-top:44px}
      .ab-h{font-size:17px;margin:0 0 16px}
      .ab-grid{display:grid;grid-template-columns:1fr;gap:14px}
      @media(min-width:700px){.ab-grid{grid-template-columns:repeat(3,1fr)}}
      .ab-grid figure{margin:0;border-radius:10px;overflow:hidden;border:1px solid #E3EBF4;background:#F5F8FC}
      .ab-grid img{display:block;width:100%;height:220px;object-fit:cover}
      .ab-grid figcaption{padding:9px 12px;font-size:12px;color:#5A7189;line-height:1.5}
      .ab-lic{display:grid;grid-template-columns:1fr;gap:16px;margin-top:20px;padding:16px;border:1px solid #E3EBF4;border-radius:10px;background:#F8FAFD;align-items:center}
      @media(min-width:700px){.ab-lic{grid-template-columns:300px 1fr}}
      .ab-lic img{display:block;width:100%;border-radius:6px;border:1px solid #E3EBF4}
      .ab-lic h4{margin:0 0 8px;font-size:14px;color:#0B2540}
      .ab-lic p{margin:0;font-size:12.5px;line-height:1.7;color:#5A7189}
    </style>
    <% } %>
    <div style="margin-top:44px">
      <h3 style="margin-bottom:14px"><%= t.sec_brands_t %></h3>
      <div class="row" style="display:flex;flex-wrap:wrap;gap:10px">
        <% ['Dow','DuPont','ExxonMobil','BASF','SABIC','Covestro','LG Chem','CHIMEI','Asahi Kasei','Polyplastics','Solvay','Borealis','Formosa','Mitsui','Toray'].forEach(b=>{ %>
          <span class="brand-chip"><%= b %></span>
        <% }); %>
      </div>
    </div>
    <div style="margin-top:44px;display:flex;gap:14px;flex-wrap:wrap">
      <a class="btn btn-primary" href="/<%= lang %>/products"><%= t.hero_cta2 %></a>
      <a class="btn btn-wa" href="https://wa.me/<%= (settings.whatsapp||'').replace(/[^0-9]/g,'') %>" target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24"><use href="#i-wa"/></svg><%= t.whatsapp_text %></a>
    </div>
  </div>
</section>

<%- include('partials/footer-v2') %>
