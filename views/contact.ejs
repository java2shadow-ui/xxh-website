<%- include('partials/header-v2', { path: 'contact', langBase: '/contact', pageCss: ['/static/css/style.css?v=20261024b','/static/css/pages-v2.css?v=20261102a'] }) %>

<section style="padding:48px 0 64px">
  <div class="wrap">
    <span class="kicker"><%= t.contact_t %></span>
    <h1 class="page-h1"><%= t.contact_s %></h1>
    <p class="sub"><%= t.contact_sub %></p>
    <div class="contact-grid" style="margin-top:34px">
      <div>
        <div class="why" style="margin-bottom:14px">
          <h3><%= t.addr_label %></h3>
          <p><%= lang==='zh'?settings.addr_zh:settings.addr_en %></p>
        </div>
        <div class="why" style="margin-bottom:14px">
          <h3><%= t.email_label %></h3>
          <p><%= settings.email %></p>
        </div>
        <div class="why" style="margin-bottom:14px">
          <h3><%= t.phone_label %></h3>
          <p><%= settings.phone %></p>
        </div>
        <div class="why" style="margin-bottom:14px">
          <h3><%= t.whatsapp_label %></h3>
          <p><%= settings.whatsapp %></p>
        </div>
        <div class="why">
          <h3><%= t.hours_label %></h3>
          <p><%= t.hours_v %></p>
        </div>
        <a class="btn btn-wa" style="margin-top:22px" href="https://wa.me/<%= (settings.whatsapp||'').replace(/[^0-9]/g,'') %>" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24"><use href="#i-wa"/></svg><%= t.whatsapp_text %>
        </a>
      </div>
      <form class="rfqform" id="rfqForm" data-lang="<%= lang %>" style="box-shadow:0 14px 44px rgba(11,31,58,.08)">
        <div class="frow">
          <div><label><%= t.form_name %> *</label><input name="name" required></div>
          <div><label><%= t.form_email %> *</label><input name="email" type="email" required></div>
        </div>
        <div class="frow">
          <div><label><%= t.form_phone %></label><input name="phone"></div>
          <div><label><%= t.form_company %></label><input name="company"></div>
        </div>
        <div><label><%= t.form_product %></label><input name="product"></div>
        <div><label><%= t.form_message %> *</label><textarea name="message" required></textarea></div>
        <div class="fmsg" id="rfqMsg"></div>
        <div style="display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap">
          <span class="fnote"><%= t.form_note %></span>
          <button class="btn btn-primary" type="submit"><%= t.form_submit %></button>
        </div>
      </form>
    </div>
    <% var CT = {
      en: 'Our office at China Plastic City, Yuyao — visitors are welcome by appointment',
      zh: '中国塑料城余姚办公室 — 欢迎预约到访',
      ru: 'Наш офис в China Plastic City, Юйяо — посещение по договорённости',
      vi: 'Văn phòng tại China Plastic City, Dư Diêu — khách đến thăm theo hẹn',
      th: 'สำนักงานที่ China Plastic City อวี้เหยา — ยินดีต้อนรับเมื่อนัดหมาย',
      id: 'Kantor kami di China Plastic City, Yuyao — kunjungan dengan perjanjian'
    }[lang] || 'Our office at China Plastic City, Yuyao'; %>
    <figure class="ct-office">
      <img src="/assets/photos/office-ningbo.jpg" alt="<%= CT %>" loading="lazy" decoding="async">
      <figcaption><%= CT %></figcaption>
    </figure>
    <style>
      .ct-office{margin:34px 0 0;border-radius:12px;overflow:hidden;border:1px solid #E3EBF4}
      .ct-office img{display:block;width:100%;height:300px;object-fit:cover}
      .ct-office figcaption{padding:11px 14px;font-size:12px;color:#5A7189;background:#F8FAFD}
      @media(max-width:640px){.ct-office img{height:190px}}
    </style>
  </div>
</section>

<script src="/static/js/main.js?v=20261024b"></script>
<%- include('partials/footer-v2') %>
