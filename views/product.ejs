<%- include('partials/header-v2', { path: 'products', langBase: '/products/' + p.slug, pageCss: ['/static/css/style.css?v=20261024b','/static/css/pages-v2.css?v=20261102a'] }) %>

<section style="padding:48px 0 64px">
  <div class="wrap">
    <p style="margin-bottom:18px"><a href="/<%= lang %>/products" style="color:var(--blue);font-weight:600">&larr; <%= t.back_products %></a></p>
    <div class="pd">
      <div class="ph">
        <% if(p.image){ %><img src="/uploads/<%= p.image %>" alt="<%= p.name_en %>">
        <% } else { %><div class="placeholder"><svg viewBox="0 0 24 24"><use href="#i-pellets"/></svg></div><% } %>
      </div>
      <div>
        <span class="cat-tag" style="font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--blue)"><%= p.brand %><%= p.grade?(' · '+p.grade):'' %></span>
        <h1><%= lang==='zh'?p.name_zh:p.name_en %></h1>
        <div class="meta">
          <% if(p.specs&&p.specs.length){ p.specs.slice(0,3).forEach(s=>{ %>
            <span><%= s[0] %>: <%= s[1] %></span>
          <% }); } %>
        </div>
        <p class="desc"><%= lang==='zh'?p.desc_zh:p.desc_en %></p>
        <a class="btn btn-wa" href="https://wa.me/<%= (settings.whatsapp||'').replace(/[^0-9]/g,'') %>?text=<%= encodeURIComponent('Hello, I am interested in '+p.name_en+' ('+p.brand+' '+(p.grade||'')+'). Please send me a quotation.') %>" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24"><use href="#i-wa"/></svg><%= t.whatsapp_text %>
        </a>
        &nbsp;<a class="btn btn-primary" href="#rfq"><%= t.inquiry_btn %></a>
      </div>
    </div>

    <% if(p.specs&&p.specs.length){ %>
    <div style="max-width:720px;margin-top:8px">
      <h3 style="margin:26px 0 4px">Technical data</h3>
      <table class="spec-table">
        <% p.specs.forEach(s=>{ %>
          <tr><th><%= s[0] %></th><td><%= s[1] %></td></tr>
        <% }); %>
      </table>
      <p style="font-size:13px;color:var(--muted)"><svg width="14" height="14" viewBox="0 0 24 24" style="vertical-align:-2px"><use href="#i-doc"/></svg> Full TDS / MSDS / COA available on request.</p>
    </div>
    <% } %>

    <% if(related.length){ %>
    <h2 style="font-size:24px;margin:48px 0 6px"><%= t.view_products %></h2>
    <div class="prod-grid">
      <% related.forEach(r=>{ %>
        <a class="prod-card" href="/<%= lang %>/products/<%= r.slug %>">
          <div class="ph"><% if(r.image){ %><img src="/uploads/<%= r.image %>" alt="<%= r.name_en %>" loading="lazy"><% } else { %><svg viewBox="0 0 24 24"><use href="#i-pellets"/></svg><% } %></div>
          <div class="bd">
            <span class="cat-tag"><%= r.brand %></span>
            <h3><%= lang==='zh'?r.name_zh:r.name_en %></h3>
            <p><%= lang==='zh'?r.desc_zh:r.desc_en %></p>
          </div>
        </a>
      <% }); %>
    </div>
    <% } %>
  </div>
</section>

<section class="rfq" id="rfq">
  <div class="wrap">
    <div class="center">
      <span class="kicker"><%= t.sec_rfq_k %></span>
      <h2 style="color:#fff"><%= t.sec_rfq_t %></h2>
    </div>
    <div class="rfq-grid" style="margin-top:36px">
      <div class="rfq-info">
        <div class="item"><span class="ic"><svg viewBox="0 0 24 24"><use href="#i-wa"/></svg></span><div><b>WhatsApp</b><span><%= settings.whatsapp %></span></div></div>
        <div class="item"><span class="ic"><svg viewBox="0 0 24 24"><use href="#i-mail"/></svg></span><div><b><%= t.email_label %></b><span><%= settings.email %></span></div></div>
      </div>
      <form class="rfqform" id="rfqForm" data-lang="<%= lang %>">
        <div class="frow">
          <div><label><%= t.form_name %> *</label><input name="name" required></div>
          <div><label><%= t.form_email %> *</label><input name="email" type="email" required></div>
        </div>
        <div><label><%= t.form_product %></label><input name="product" value="<%= p.name_en %>"></div>
        <div><label><%= t.form_message %> *</label><textarea name="message" required></textarea></div>
        <div class="fmsg" id="rfqMsg"></div>
        <div style="display:flex;justify-content:flex-end"><button class="btn btn-primary" type="submit"><%= t.form_submit %></button></div>
      </form>
    </div>
  </div>
</section>

<script src="/static/js/main.js?v=20261024b"></script>
<%- include('partials/footer-v2') %>
